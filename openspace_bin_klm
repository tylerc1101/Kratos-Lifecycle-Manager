#!/usr/bin/env bash
set -euo pipefail

KLM_CONTAINER="klm-engine"

KLM_ROOT="/opt/openspace"
KLM_BUNDLES="${KLM_ROOT}/bundles"
KLM_CONFIG="${KLM_ROOT}/config"
KLM_ENGINE="${KLM_ROOT}/engine"
KLM_ENVIRONMENTS="${KLM_ROOT}/environments"
KLM_REPOS="${KLM_ROOT}/repos"
KLM_SECRETS="${KLM_ROOT}/secrets"
KLM_STAGING="${KLM_ROOT}/staging"

KLM_STATE="${KLM_ROOT}/state"
KLM_KLM_STATE="${KLM_STATE}/klm"
KLM_SEMAPHORE_STATE="${KLM_STATE}/semaphore"
KLM_TLS_STATE="${KLM_STATE}/tls"
KLM_SELECTION_FILE="${KLM_KLM_STATE}/environment.yml"
KLM_OWNERSHIP_FILE="${KLM_KLM_STATE}/ownership.json"

BUNDLE_IMPORT_TEMP=""


cleanup() {
    if [ -n "${BUNDLE_IMPORT_TEMP}" ] && [ -d "${BUNDLE_IMPORT_TEMP}" ]; then
        rm -rf "${BUNDLE_IMPORT_TEMP}"
    fi
}

trap cleanup EXIT


usage() {
    cat <<'EOF'
KLM - Kratos Lifecycle Manager

Usage:
  klm <command>

Engine:
  klm engine import
      Install or replace the KLM engine from staging.

  klm engine image
      Show the installed engine image and engine artifacts.

  klm engine image cleanup
      Remove unused KLM engine images, including KLM-labeled dangling
      images left by same-version rebuilds. The active/current image is kept.

Container:
  klm start
      Start KLM and ensure the Semaphore KLM project exists.

  klm stop
      Stop the KLM container.

  klm restart
      Recreate and restart the KLM container.

  klm status
      Show engine and container status.

  klm logs
      Follow KLM/Semaphore container logs.

  klm shell
      Open an interactive shell inside the KLM container.

Bundles:
  klm bundles import
      Validate and install or replace every .bundle file in staging.
      A staged copy replaces the installed copy even when the version is
      unchanged. Bundle type decides the install location.

  klm bundles list
      Show installed capability, architecture, and environment bundles.

  klm bundles validate
      Validate installed bundles, dependencies, and desired-state structure.

  klm bundles remove <name>
      Remove an installed bundle and its retained artifact. Semaphore is not
      changed until the next reconcile. A selected environment cannot be
      removed until its selection is cleared.

Environment:
  klm env
      Show the active environment/system and available systems.

  klm env <system>
      Select a system from an installed environment bundle.

  klm env clear
      Clear the active environment/system selection.

State:
  klm state show
      Show KLM selection, ownership, Semaphore, TLS, and backup state.

  klm state clean
      Clear environment selection and stale KLM temporary state. Ownership,
      Semaphore database, Key Store data, security keys, and TLS are kept.

  klm state reset
      Reset persistent KLM/Semaphore state for a fresh run. Installed engine,
      bundles, environments, and staging artifacts are preserved.

Reconciliation:
  klm reconcile
      Make Semaphore match the current KLM desired state.

  klm reconcile --dry-run
      Show planned changes without modifying Semaphore.

Other:
  klm version
      Show the KLM engine version.

  klm doctor
      Validate KLM configuration and Semaphore connectivity.

  klm help
      Show this help.
EOF
}


container_exists() {
    podman container exists "${KLM_CONTAINER}"
}


container_running() {
    if ! container_exists; then
        return 1
    fi

    podman inspect \
        --format '{{.State.Running}}' \
        "${KLM_CONTAINER}" | grep -q '^true$'
}


get_engine_images() {
    podman images \
        --format '{{.Repository}}:{{.Tag}}' \
        | grep -E '(^|/)klm-engine:[^[:space:]]+$' \
        | grep -v ':<none>$' \
        || true
}


get_engine_image() {
    local images=()

    mapfile -t images < <(get_engine_images)

    if [ "${#images[@]}" -eq 0 ]; then
        echo "ERROR: No KLM engine image is installed." >&2
        return 1
    fi

    if [ "${#images[@]}" -gt 1 ]; then
        echo "ERROR: More than one KLM engine image is installed:" >&2
        printf '  %s\n' "${images[@]}" >&2
        echo >&2
        echo "KLM expects only one engine image at a time." >&2
        return 1
    fi

    echo "${images[0]}"
}


wait_for_semaphore() {
    local attempt

    for attempt in $(seq 1 30); do
        if podman exec "${KLM_CONTAINER}" \
            curl -ksf https://127.0.0.1:3000/api/ping \
            >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done

    echo "ERROR: Semaphore did not become ready within 30 seconds." >&2
    return 1
}


ensure_klm_project() {
    wait_for_semaphore

    podman exec -i \
        "${KLM_CONTAINER}" \
        /usr/local/bin/klm-engine ensure-project
}


start_klm() {
    local engine_image

    if container_running; then
        echo "KLM is already running."
        ensure_klm_project
        return
    fi

    if container_exists; then
        echo "Starting existing KLM container..."
        podman start "${KLM_CONTAINER}" >/dev/null
        ensure_klm_project
        echo "KLM started."
        return
    fi

    engine_image="$(get_engine_image)"

    echo "Creating KLM container..."
    echo "Image:"
    echo "  ${engine_image}"
    echo

    podman run -d \
        --name "${KLM_CONTAINER}" \
        --network host \
        --restart=always \
        -v "${KLM_BUNDLES}:${KLM_BUNDLES}:ro,z" \
        -v "${KLM_CONFIG}:${KLM_CONFIG}:ro,Z" \
        -v "${KLM_ENVIRONMENTS}:${KLM_ENVIRONMENTS}:ro,Z" \
        -v "${KLM_REPOS}:${KLM_REPOS}:Z" \
        -v "${KLM_SECRETS}:${KLM_SECRETS}:ro,Z" \
        -v "${KLM_STAGING}:${KLM_STAGING}:ro,z" \
        -v "${KLM_STATE}:${KLM_STATE}:Z" \
        "${engine_image}" \
        >/dev/null

    ensure_klm_project

    echo
    echo "KLM started."
}


stop_klm() {
    if ! container_exists; then
        echo "KLM is not deployed."
        return
    fi

    if ! container_running; then
        echo "KLM is already stopped."
        return
    fi

    echo "Stopping KLM..."
    podman stop "${KLM_CONTAINER}"

    echo "KLM stopped."
}


restart_klm() {
    if container_exists; then
        echo "Removing existing KLM container..."
        podman rm -f "${KLM_CONTAINER}"
    fi

    start_klm
}


status_klm() {
    local images=()

    mapfile -t images < <(get_engine_images)

    echo "KLM engine:"
    echo

    if [ "${#images[@]}" -eq 0 ]; then
        echo "  Image: not imported"
    else
        printf '  Image: %s\n' "${images[@]}"
    fi

    echo

    if ! container_exists; then
        echo "KLM container: not deployed"
        return
    fi

    podman ps -a \
        --filter "name=${KLM_CONTAINER}" \
        --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"
}


logs_klm() {
    if ! container_exists; then
        echo "ERROR: KLM is not deployed."
        exit 1
    fi

    podman logs -f "${KLM_CONTAINER}"
}


shell_klm() {
    if ! container_running; then
        echo "ERROR: KLM is not running."
        exit 1
    fi

    podman exec -it "${KLM_CONTAINER}" /bin/bash
}

run_engine_command() {
    if ! container_running; then
        echo "ERROR: KLM is not running."
        exit 1
    fi

    podman exec -i \
        "${KLM_CONTAINER}" \
        /usr/local/bin/klm-engine "$@"
}

backup_semaphore_database() {
    local database="${KLM_STATE}/semaphore/database.sqlite"
    local backup_root="${KLM_STATE}/backups"
    local backup_dir

    if [ ! -f "${database}" ]; then
        return
    fi

    backup_dir="${backup_root}/$(date +%Y%m%d-%H%M%S)"

    echo "Backing up Semaphore database:"
    echo "  ${backup_dir}"
    echo

    mkdir -p "${backup_dir}"

    cp -a "${database}" "${backup_dir}/"

    if [ -f "${database}-wal" ]; then
        cp -a "${database}-wal" "${backup_dir}/"
    fi

    if [ -f "${database}-shm" ]; then
        cp -a "${database}-shm" "${backup_dir}/"
    fi

    # Keep backup permissions private while still allowing the runtime UID
    # to access them if recovery is needed inside the container.
    chown -R 1000:1000 "${backup_dir}"
    chmod 0700 "${backup_dir}"
    find "${backup_dir}" -type f -exec chmod 0600 {} \;
}


import_engine() {
    local engine_tars=()
    local engine_tar
    local load_output
    local loaded_image
    local old_images=()

    mapfile -t engine_tars < <(
        find "${KLM_STAGING}" \
            -maxdepth 1 \
            -type f \
            -name 'klm-engine-*.tar' \
            -print \
            | sort
    )

    if [ "${#engine_tars[@]}" -eq 0 ]; then
        echo "ERROR: No KLM engine tar was found in:"
        echo "  ${KLM_STAGING}"
        echo
        echo "Expected something like:"
        echo "  ${KLM_STAGING}/klm-engine-1.0.0.tar"
        exit 1
    fi

    if [ "${#engine_tars[@]}" -gt 1 ]; then
        echo "ERROR: More than one KLM engine tar was found in staging:"
        printf '  %s\n' "${engine_tars[@]}"
        echo
        echo "Leave only the engine you want to import in staging."
        exit 1
    fi

    engine_tar="${engine_tars[0]}"

    echo "Importing KLM engine:"
    echo "  ${engine_tar}"
    echo

    load_output="$(podman load -i "${engine_tar}" 2>&1)"

    echo "${load_output}"
    echo

    loaded_image="$(
        printf '%s\n' "${load_output}" \
            | sed -n 's/^Loaded image: //p' \
            | tail -n 1
    )"

    if [ -z "${loaded_image}" ]; then
        echo "ERROR: Podman loaded the archive, but KLM could not determine"
        echo "the image name from the load output."
        exit 1
    fi

    if ! printf '%s\n' "${loaded_image}" \
        | grep -Eq '(^|/)klm-engine:[^[:space:]]+$'; then

        echo "ERROR: The imported image does not appear to be a KLM engine."
        echo
        echo "Loaded image:"
        echo "  ${loaded_image}"
        exit 1
    fi

    if ! podman image exists "${loaded_image}"; then
        echo "ERROR: Imported image could not be found:"
        echo "  ${loaded_image}"
        exit 1
    fi

    echo "Detected engine image:"
    echo "  ${loaded_image}"
    echo

    # If an older KLM container exists, remove it only after the new
    # engine has loaded successfully.
    if container_exists; then
        echo "Removing existing KLM container..."
        podman rm -f "${KLM_CONTAINER}"
        echo
    fi

    # Semaphore is stopped at this point, so copying SQLite + WAL/SHM is
    # consistent enough for a simple engine-import recovery point.
    backup_semaphore_database

    # Remove older KLM engine images.
    mapfile -t old_images < <(get_engine_images)

    for image in "${old_images[@]}"; do
        if [ "${image}" != "${loaded_image}" ]; then
            echo "Removing previous engine image:"
            echo "  ${image}"

            podman image rm "${image}"
        fi
    done

    # Move the newly imported tar into the engine directory.
    # Only the current engine tar is retained.
    mv "${engine_tar}" "${KLM_ENGINE}/.klm-engine-import.tar"

    rm -f "${KLM_ENGINE}"/*.tar

    mv \
        "${KLM_ENGINE}/.klm-engine-import.tar" \
        "${KLM_ENGINE}/$(basename "${engine_tar}")"

    echo
    echo "KLM engine import complete."
    echo
    echo "Engine image:"
    echo "  ${loaded_image}"
    echo
    echo "Stored engine artifact:"
    echo "  ${KLM_ENGINE}/$(basename "${engine_tar}")"
    echo
    echo "KLM is stopped after import."
    echo "Run:"
    echo "  klm start"
}


list_engines() {
    local images=()

    mapfile -t images < <(get_engine_images)

    echo "KLM engine image:"

    if [ "${#images[@]}" -eq 0 ]; then
        echo "  None"
    else
        printf '  %s\n' "${images[@]}"
    fi

    echo
    echo "Stored engine artifact:"

    if compgen -G "${KLM_ENGINE}/*.tar" > /dev/null; then
        ls -lh "${KLM_ENGINE}"/*.tar
    else
        echo "  None"
    fi

    echo
    echo "Staged engine artifact:"

    if compgen -G "${KLM_STAGING}/klm-engine-*.tar" > /dev/null; then
        ls -lh "${KLM_STAGING}"/klm-engine-*.tar
    else
        echo "  None"
    fi
}


get_container_image_id() {
    if ! container_exists; then
        return 1
    fi

    podman inspect \
        --format '{{.Image}}' \
        "${KLM_CONTAINER}" \
        2>/dev/null || true
}


get_engine_image_id() {
    local image_ref="$1"

    podman image inspect \
        --format '{{.Id}}' \
        "${image_ref}" \
        2>/dev/null || true
}


cleanup_engine_images() {
    local tagged_images=()
    local candidate_ids=()
    local protected_id=""
    local container_id=""
    local stored_tars=()
    local stored_version=""
    local stored_matches=()
    local image
    local image_id
    local candidate_id
    local removed=0

    mapfile -t tagged_images < <(get_engine_images)

    # Prefer the image actually backing the KLM container, even if stopped.
    container_id="$(get_container_image_id || true)"
    if [ -n "${container_id}" ]; then
        protected_id="${container_id}"
    fi

    # If no container exists, use the single stored engine artifact to identify
    # the current tag when possible.
    if [ -z "${protected_id}" ]; then
        if [ -d "${KLM_ENGINE}" ]; then
            mapfile -t stored_tars < <(
                find "${KLM_ENGINE}" \
                    -maxdepth 1 \
                    -type f \
                    -name 'klm-engine-*.tar' \
                    -print \
                    | sort
            )
        fi

        if [ "${#stored_tars[@]}" -eq 1 ]; then
            stored_version="$(basename "${stored_tars[0]}")"
            stored_version="${stored_version#klm-engine-}"
            stored_version="${stored_version%.tar}"

            for image in "${tagged_images[@]}"; do
                if [[ "${image}" == *"/klm-engine:${stored_version}" ]] || \
                   [[ "${image}" == "klm-engine:${stored_version}" ]]; then
                    stored_matches+=("${image}")
                fi
            done

            if [ "${#stored_matches[@]}" -eq 1 ]; then
                protected_id="$(get_engine_image_id "${stored_matches[0]}")"
            fi
        fi
    fi

    # A single tagged engine image is unambiguous.
    if [ -z "${protected_id}" ] && [ "${#tagged_images[@]}" -eq 1 ]; then
        protected_id="$(get_engine_image_id "${tagged_images[0]}")"
    fi

    if [ -z "${protected_id}" ] && [ "${#tagged_images[@]}" -gt 1 ]; then
        echo "ERROR: More than one tagged KLM engine image exists and KLM" >&2
        echo "cannot determine which one should be preserved." >&2
        printf '  %s\n' "${tagged_images[@]}" >&2
        echo >&2
        echo "Start the engine you want to keep, or leave one current engine" >&2
        echo "artifact in ${KLM_ENGINE}, then retry." >&2
        exit 1
    fi

    # Collect images explicitly tagged as klm-engine.
    for image in "${tagged_images[@]}"; do
        image_id="$(get_engine_image_id "${image}")"
        if [ -n "${image_id}" ]; then
            candidate_ids+=("${image_id}")
        fi
    done

    # New engine images carry this label. It lets cleanup safely identify
    # dangling images produced when the same version/tag is rebuilt.
    while IFS= read -r image_id; do
        [ -z "${image_id}" ] && continue
        image_id="$(get_engine_image_id "${image_id}")"
        [ -n "${image_id}" ] && candidate_ids+=("${image_id}")
    done < <(
        podman images \
            --filter 'label=com.kratos.klm.component=engine' \
            --format '{{.ID}}' \
            2>/dev/null || true
    )

    if [ "${#candidate_ids[@]}" -eq 0 ]; then
        echo "No KLM engine images found to clean."
        return
    fi

    mapfile -t candidate_ids < <(printf '%s\n' "${candidate_ids[@]}" | sort -u)

    echo "KLM engine image cleanup:"
    if [ -n "${protected_id}" ]; then
        echo "  Keeping: ${protected_id}"
    else
        echo "  No current KLM engine image is installed."
    fi
    echo

    for candidate_id in "${candidate_ids[@]}"; do
        if [ -n "${protected_id}" ] && [ "${candidate_id}" = "${protected_id}" ]; then
            continue
        fi

        echo "Removing unused KLM engine image:"
        echo "  ${candidate_id}"

        if podman image rm "${candidate_id}"; then
            removed=$((removed + 1))
        else
            echo "WARNING: Could not remove ${candidate_id}. It may still be in use." >&2
        fi
        echo
    done

    if [ "${removed}" -eq 0 ]; then
        echo "No unused KLM engine images needed removal."
    else
        echo "Removed ${removed} unused KLM engine image(s)."
    fi
}


import_bundles() {
    local bundle_files=()
    local records=()
    local bundle_file
    local item_name
    local item_dir
    local top_dir
    local extracted
    local metadata
    local name
    local version
    local bundle_type
    local target
    local artifact_dir
    local record
    local index=0

    declare -A staged_names=()

    if ! container_running; then
        echo "ERROR: KLM must be running before importing bundles." >&2
        echo "Run: klm start" >&2
        exit 1
    fi

    mapfile -t bundle_files < <(
        find "${KLM_STAGING}" \
            -maxdepth 1 \
            -type f \
            -name '*.bundle' \
            -print \
            | sort
    )

    if [ "${#bundle_files[@]}" -eq 0 ]; then
        echo "ERROR: No bundle artifacts were found in:" >&2
        echo "  ${KLM_STAGING}" >&2
        echo >&2
        echo "Expected files such as:" >&2
        echo "  onboarder-1.0.0.bundle" >&2
        echo "  openspace-1.0.0.bundle" >&2
        echo "  basekit-1.0.0.bundle" >&2
        echo "  afcgi-1.0.0.bundle" >&2
        exit 1
    fi

    BUNDLE_IMPORT_TEMP="${KLM_STAGING}/.klm-bundle-import-$$"

    rm -rf "${BUNDLE_IMPORT_TEMP}"
    mkdir -p "${BUNDLE_IMPORT_TEMP}"
    chmod 0755 "${BUNDLE_IMPORT_TEMP}"

    if id kratos >/dev/null 2>&1; then
        chown kratos:kratos "${BUNDLE_IMPORT_TEMP}"
    fi

    echo "Found ${#bundle_files[@]} bundle artifact(s)."
    echo
    echo "Validating bundles..."
    echo

    # Validate every staged artifact before replacing any installed bundle.
    for bundle_file in "${bundle_files[@]}"; do
        item_name="item-${index}"
        item_dir="${BUNDLE_IMPORT_TEMP}/${item_name}"

        mkdir -p "${item_dir}"
        chmod 0755 "${item_dir}"

        top_dir="$(python3 - "${bundle_file}" "${item_dir}" <<'PYBUNDLE'
import posixpath
import sys
import tarfile
import warnings

archive, destination = sys.argv[1], sys.argv[2]
roots = set()

# RHEL backports safer tarfile extraction behavior to Python 3.9 and emits a
# RuntimeWarning. KLM performs its own strict member validation below.
warnings.filterwarnings("ignore", category=RuntimeWarning)

with tarfile.open(archive, "r:*") as tar:
    members = tar.getmembers()
    if not members:
        raise SystemExit("bundle is empty")

    for member in members:
        name = member.name.replace("\\", "/")
        normalized = posixpath.normpath(name)

        if normalized in (".", ""):
            continue

        if normalized.startswith("/") or normalized == ".." or normalized.startswith("../"):
            raise SystemExit("unsafe path in bundle: %s" % member.name)

        if member.issym() or member.islnk():
            raise SystemExit("links are not allowed in bundles: %s" % member.name)

        if not member.isfile() and not member.isdir():
            raise SystemExit("special files are not allowed in bundles: %s" % member.name)

        roots.add(normalized.split("/", 1)[0])

    if len(roots) != 1:
        raise SystemExit(
            "bundle must contain exactly one top-level directory; found: %s"
            % ", ".join(sorted(roots))
        )

    root = next(iter(roots))

    for member in members:
        tar.extract(member, destination)

print(root)
PYBUNDLE
)"

        # The engine runs as a non-root user. Make every extracted directory
        # traversable and every file readable before container-side validation.
        if id kratos >/dev/null 2>&1; then
            chown -R kratos:kratos "${item_dir}"
        fi

        find "${item_dir}" -type d -exec chmod 0755 {} \;
        chmod -R a+rX "${item_dir}"

        extracted="${item_dir}/${top_dir}"

        if [ ! -f "${extracted}/bundle.yml" ] || [ ! -f "${extracted}/semaphore.yml" ]; then
            echo "ERROR: $(basename "${bundle_file}") must contain bundle.yml and semaphore.yml." >&2
            exit 1
        fi

        metadata="$(
            podman exec -i \
                "${KLM_CONTAINER}" \
                /usr/local/bin/klm-engine \
                bundle-validate-path \
                "${KLM_STAGING}/$(basename "${BUNDLE_IMPORT_TEMP}")/${item_name}/${top_dir}"
        )"

        IFS=$'\t' read -r name version bundle_type <<< "${metadata}"

        if [ -z "${name}" ] || [ -z "${version}" ] || [ -z "${bundle_type}" ]; then
            echo "ERROR: Could not read bundle metadata from $(basename "${bundle_file}")." >&2
            exit 1
        fi

        if [ -n "${staged_names[${name}]+x}" ]; then
            echo "ERROR: More than one staged artifact declares bundle name '${name}'." >&2
            exit 1
        fi
        staged_names["${name}"]=1

        case "${bundle_type}" in
            capability|architecture)
                if [ -e "${KLM_ENVIRONMENTS}/${name}" ]; then
                    echo "ERROR: Bundle '${name}' is already installed as an environment." >&2
                    exit 1
                fi
                ;;

            environment)
                if [ -e "${KLM_BUNDLES}/${name}" ]; then
                    echo "ERROR: Bundle '${name}' is already installed as a capability/architecture bundle." >&2
                    exit 1
                fi
                ;;

            *)
                echo "ERROR: Unsupported bundle type '${bundle_type}' for '${name}'." >&2
                exit 1
                ;;
        esac

        printf "  OK  %-15s %-10s %s\n" \
            "${name}" \
            "${version}" \
            "${bundle_type}"

        records+=(
            "${bundle_file}"$'\t'"${item_name}"$'\t'"${top_dir}"$'\t'"${name}"$'\t'"${version}"$'\t'"${bundle_type}"
        )

        index=$((index + 1))
    done

    echo
    echo "Installing bundles..."
    echo

    for record in "${records[@]}"; do
        IFS=$'\t' read -r \
            bundle_file \
            item_name \
            top_dir \
            name \
            version \
            bundle_type \
            <<< "${record}"

        if [ "${bundle_type}" = "environment" ]; then
            target="${KLM_ENVIRONMENTS}/${name}"
            artifact_dir="${KLM_ENVIRONMENTS}/.artifacts"
        else
            target="${KLM_BUNDLES}/${name}"
            artifact_dir="${KLM_BUNDLES}/.artifacts"
        fi

        mkdir -p "${artifact_dir}"

        rm -rf "${target}"
        mv \
            "${BUNDLE_IMPORT_TEMP}/${item_name}/${top_dir}" \
            "${target}"

        # Retain only the current imported artifact for this bundle name.
        rm -f \
            "${artifact_dir}/${name}-"*.bundle \
            "${artifact_dir}/klm-env-${name}-"*.bundle \
            2>/dev/null || true

        mv \
            "${bundle_file}" \
            "${artifact_dir}/$(basename "${bundle_file}")"

        if id kratos >/dev/null 2>&1; then
            chown -R kratos:kratos "${target}" "${artifact_dir}"
        fi

        find "${target}" -type d -exec chmod 0755 {} \;
        chmod -R a+rX "${target}"
        chmod 0644 "${artifact_dir}/$(basename "${bundle_file}")"

        printf "  %-15s -> %s\n" "${name}" "${target}"
    done

    rm -rf "${BUNDLE_IMPORT_TEMP}"
    BUNDLE_IMPORT_TEMP=""

    echo
    echo "Bundle import complete."
    echo
    echo "Run:"
    echo "  klm bundles list"
    echo "  klm bundles validate"
}


selected_environment_name() {
    if [ ! -f "${KLM_SELECTION_FILE}" ]; then
        return
    fi

    awk -F': *' '$1 == "environment" {print $2; exit}' "${KLM_SELECTION_FILE}"
}


remove_bundle() {
    local name="${1:-}"
    local bundle_path
    local environment_path
    local selected_environment

    if [ -z "${name}" ]; then
        echo "ERROR: Bundle name is required." >&2
        echo "Usage: klm bundles remove <name>" >&2
        exit 1
    fi

    if ! [[ "${name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "ERROR: Invalid bundle name '${name}'." >&2
        exit 1
    fi

    bundle_path="${KLM_BUNDLES}/${name}"
    environment_path="${KLM_ENVIRONMENTS}/${name}"

    if [ -e "${bundle_path}" ] && [ -e "${environment_path}" ]; then
        echo "ERROR: '${name}' exists in both bundles and environments." >&2
        echo "Resolve the filesystem conflict before removing it." >&2
        exit 1
    fi

    if [ -d "${environment_path}" ]; then
        selected_environment="$(selected_environment_name)"

        if [ "${selected_environment}" = "${name}" ]; then
            echo "ERROR: Environment '${name}' is currently selected." >&2
            echo "Run:" >&2
            echo "  klm env clear" >&2
            echo "before removing it." >&2
            exit 1
        fi

        rm -rf "${environment_path}"
        rm -f \
            "${KLM_ENVIRONMENTS}/.artifacts/${name}-"*.bundle \
            "${KLM_ENVIRONMENTS}/.artifacts/klm-env-${name}-"*.bundle \
            2>/dev/null || true

        echo "Removed environment bundle '${name}'."
        echo "Run 'klm reconcile' to converge Semaphore to the new desired state."
        return
    fi

    if [ -d "${bundle_path}" ]; then
        rm -rf "${bundle_path}"
        rm -f \
            "${KLM_BUNDLES}/.artifacts/${name}-"*.bundle \
            2>/dev/null || true

        echo "Removed bundle '${name}'."
        echo "Run 'klm reconcile' to converge Semaphore to the new desired state."
        return
    fi

    echo "ERROR: Bundle '${name}' is not installed." >&2
    exit 1
}


state_show() {
    local environment=""
    local system=""
    local backup_count=0

    echo "KLM persistent state:"
    echo

    if [ -f "${KLM_SELECTION_FILE}" ]; then
        environment="$(awk -F': *' '$1 == "environment" {print $2; exit}' "${KLM_SELECTION_FILE}")"
        system="$(awk -F': *' '$1 == "system" {print $2; exit}' "${KLM_SELECTION_FILE}")"
        echo "Selection:"
        echo "  Environment: ${environment:-unknown}"
        echo "  System:      ${system:-unknown}"
    else
        echo "Selection:"
        echo "  none"
    fi

    echo
    echo "Ownership:"
    if [ -f "${KLM_OWNERSHIP_FILE}" ]; then
        python3 - "${KLM_OWNERSHIP_FILE}" <<'PYSTATE'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as handle:
    data = json.load(handle)

for key in ("projects", "repositories", "inventories", "views", "templates", "workflows"):
    value = data.get(key, {})
    print("  %-14s %d" % (key.capitalize() + ":", len(value) if isinstance(value, dict) else 0))
PYSTATE
        echo "  File:          ${KLM_OWNERSHIP_FILE}"
    else
        echo "  none"
    fi

    echo
    echo "Semaphore:"
    if [ -f "${KLM_SEMAPHORE_STATE}/database.sqlite" ]; then
        echo "  Database:      present ($(du -h "${KLM_SEMAPHORE_STATE}/database.sqlite" | awk '{print $1}'))"
    else
        echo "  Database:      not initialized"
    fi

    if [ -f "${KLM_SEMAPHORE_STATE}/secrets.env" ]; then
        echo "  Security keys: present"
    else
        echo "  Security keys: not initialized"
    fi

    echo
    echo "TLS:"
    if [ -f "${KLM_TLS_STATE}/klm.crt" ] && [ -f "${KLM_TLS_STATE}/klm.key" ]; then
        echo "  Certificate/key: present"
    else
        echo "  Certificate/key: not initialized"
    fi

    if [ -d "${KLM_STATE}/backups" ]; then
        backup_count="$(find "${KLM_STATE}/backups" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    fi

    echo
    echo "Database backups:"
    echo "  ${backup_count}"
}


state_clean() {
    mkdir -p "${KLM_KLM_STATE}"
    chown 1000:1000 "${KLM_KLM_STATE}"

    rm -f \
        "${KLM_SELECTION_FILE}" \
        "${KLM_KLM_STATE}"/*.tmp \
        2>/dev/null || true

    echo "KLM state cleanup complete."
    echo
    echo "Cleared:"
    echo "  environment/system selection"
    echo "  stale KLM temporary state"
    echo
    echo "Preserved:"
    echo "  ownership state"
    echo "  Semaphore database and Key Store data"
    echo "  Semaphore security keys"
    echo "  TLS certificate/key"
}


state_reset() {
    local assume_yes="${1:-}"
    local answer=""

    if [ -n "${assume_yes}" ] && [ "${assume_yes}" != "--yes" ]; then
        echo "ERROR: Unknown option '${assume_yes}'." >&2
        echo "Usage: klm state reset [--yes]" >&2
        exit 1
    fi

    if [ "${assume_yes}" != "--yes" ]; then
        cat <<'EOF'
WARNING: This will remove all persistent KLM/Semaphore runtime state.

This includes:
  - Semaphore database, users, project, inventories, templates, and Key Store data
  - KLM ownership and environment selection
  - Semaphore security keys
  - KLM TLS certificate/key
  - KLM state backups

Preserved:
  - installed KLM engine image/artifact
  - installed bundles and environments
  - staging artifacts

Continue? [y/N]:
EOF
        read -r answer
        case "${answer}" in
            y|Y|yes|YES) ;;
            *)
                echo "State reset cancelled."
                return
                ;;
        esac
    fi

    if container_exists; then
        echo "Removing KLM container..."
        podman rm -f "${KLM_CONTAINER}" >/dev/null
    fi

    rm -rf "${KLM_STATE}"

    # An API token tied to the old Semaphore database is no longer valid.
    rm -f "${KLM_SECRETS}/semaphore_api_token"

    mkdir -p \
        "${KLM_KLM_STATE}" \
        "${KLM_SEMAPHORE_STATE}" \
        "${KLM_TLS_STATE}"

    chown -R 1000:1000 "${KLM_STATE}"

    echo
    echo "KLM persistent state reset complete."
    echo "Installed engine and bundles were preserved."
    echo
    echo "Next:"
    echo "  klm start"
}


case "${1:-}" in

    start)
        start_klm
        ;;

    stop)
        stop_klm
        ;;

    restart)
        restart_klm
        ;;

    status)
        status_klm
        ;;

    logs)
        logs_klm
        ;;

    shell)
        shell_klm
        ;;

    engine)
        case "${2:-}" in

            import)
                import_engine
                ;;

            image|list)
                if [ "${3:-}" = "cleanup" ]; then
                    cleanup_engine_images
                elif [ -n "${3:-}" ]; then
                    echo "Usage:" >&2
                    echo "  klm engine image" >&2
                    echo "  klm engine image cleanup" >&2
                    exit 1
                else
                    list_engines
                fi
                ;;

            *)
                usage
                exit 1
                ;;

        esac
        ;;

    bundles)
        case "${2:-}" in
            import)
                import_bundles
                ;;
            remove)
                remove_bundle "${3:-}"
                ;;
            list|validate)
                run_engine_command "$@"
                ;;
            *)
                echo "Usage:" >&2
                echo "  klm bundles import" >&2
                echo "  klm bundles list" >&2
                echo "  klm bundles validate" >&2
                echo "  klm bundles remove <name>" >&2
                exit 1
                ;;
        esac
        ;;

    env)
        if [ "${2:-}" = "import" ]; then
            echo "NOTE: 'klm env import' has been replaced by 'klm bundles import'."
            echo
            import_bundles
        else
            run_engine_command "$@"
        fi
        ;;

    state)
        case "${2:-}" in
            show)
                state_show
                ;;
            clean)
                state_clean
                ;;
            reset)
                state_reset "${3:-}"
                ;;
            *)
                echo "Usage:" >&2
                echo "  klm state show" >&2
                echo "  klm state clean" >&2
                echo "  klm state reset [--yes]" >&2
                exit 1
                ;;
        esac
        ;;

    help|-h|--help|"")
        usage
        ;;

    *)
        run_engine_command "$@"
        ;;

esac
